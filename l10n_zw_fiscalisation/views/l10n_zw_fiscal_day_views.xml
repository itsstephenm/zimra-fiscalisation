<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fiscal Day Form View -->
    <record id="view_l10n_zw_fiscal_day_form" model="ir.ui.view">
        <field name="name">l10n_zw.fiscal.day.form</field>
        <field name="model">l10n_zw.fiscal.day</field>
        <field name="arch" type="xml">
            <form string="ZIMRA Fiscal Day">
                <header>
                    <button name="action_open_day" string="Open Fiscal Day" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_close_day" string="Close Fiscal Day (Z-Report)" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'open')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="fiscal_day_no"/>
                        </group>
                        <group>
                            <field name="opened_at"/>
                            <field name="closed_at"/>
                        </group>
                    </group>
                    <group string="Status">
                        <field name="receipts_reported"/>
                        <field name="receipt_counter_closed"/>
                        <field name="error_message" attrs="{'invisible': [('error_message', '=', False)]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fiscal Day Tree View -->
    <record id="view_l10n_zw_fiscal_day_tree" model="ir.ui.view">
        <field name="name">l10n_zw.fiscal.day.tree</field>
        <field name="model">l10n_zw.fiscal.day</field>
        <field name="arch" type="xml">
            <tree string="ZIMRA Fiscal Days" decoration-info="state == 'draft'" decoration-success="state == 'closed'" decoration-warning="state == 'open'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="fiscal_day_no"/>
                <field name="opened_at"/>
                <field name="closed_at"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l10n_zw_fiscal_day" model="ir.actions.act_window">
        <field name="name">ZIMRA Fiscal Days</field>
        <field name="res_model">l10n_zw.fiscal.day</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new ZIMRA Fiscal Day
          </p><p>
            A fiscal day must be opened before any receipts can be issued to ZIMRA.
          </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_l10n_zw_fiscalisation_root" 
              name="ZIMRA Fiscalisation" 
              parent="account.menu_finance_configuration" 
              sequence="100"/>
              
    <menuitem id="menu_l10n_zw_fiscal_days" 
              name="Fiscal Days" 
              parent="menu_l10n_zw_fiscalisation_root" 
              action="action_l10n_zw_fiscal_day" 
              sequence="10"/>

</odoo>
