<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add ZIMRA status fields to the Invoice form view -->
    <record id="view_move_form_zimra" model="ir.ui.view">
        <field name="name">account.move.form.zimra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add ZIMRA status badges to the header -->
            <xpath expr="//header" position="inside">
                <div class="o_row" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <span class="badge rounded-pill text-bg-success" invisible="l10n_zw_status != 'submitted'">
                        ✓ Fiscalised — Receipt #<field name="l10n_zw_receipt_global_no" readonly="1"/>
                    </span>
                    <span class="badge rounded-pill text-bg-danger" invisible="l10n_zw_status != 'error'">
                        ✗ ZIMRA Error
                    </span>
                </div>
            </xpath>

            <!-- Add a ZIMRA tab to the notebook area -->
            <xpath expr="//notebook" position="inside">
                <page string="ZIMRA Fiscalisation" name="zimra_page" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group col="2">
                        <group string="Submission Details">
                            <field name="l10n_zw_status" readonly="1"/>
                            <field name="l10n_zw_receipt_global_no" readonly="1"/>
                            <field name="l10n_zw_receipt_id" readonly="1"/>
                            <field name="l10n_zw_operation_id" readonly="1"/>
                        </group>
                        <group string="Error Info" invisible="l10n_zw_status != 'error'">
                            <field name="l10n_zw_error_message" readonly="1" widget="text"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>