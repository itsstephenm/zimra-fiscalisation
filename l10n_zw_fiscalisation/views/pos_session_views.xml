<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_session_form_zimra" model="ir.ui.view">
        <field name="name">pos.session.form.view.zimra</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <!-- Add buttons to the header -->
            <xpath expr="//header" position="inside">
                <field name="l10n_zw_fiscal_day_status" invisible="1"/>
                <button name="action_l10n_zw_open_fiscal_day" 
                        string="Open ZIMRA Day" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'opened' or l10n_zw_fiscal_day_status == 'open'"/>
                
                <button name="action_l10n_zw_close_fiscal_day" 
                        string="Close ZIMRA Day (Z-Report)" 
                        type="object" 
                        class="btn-warning"
                        invisible="state != 'closing_control' or l10n_zw_fiscal_day_status != 'open'"/>
            </xpath>
            
            <!-- Add a small status indicator in the form -->
            <xpath expr="//group[@name='general']" position="inside">
                <field name="l10n_zw_fiscal_day_id" invisible="not l10n_zw_fiscal_day_id"/>
            </xpath>
        </field>
    </record>

</odoo>
