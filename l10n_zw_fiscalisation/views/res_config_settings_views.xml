<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the General Settings page to add a ZIMRA section -->
    <record id="res_config_settings_view_form_zimra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.zimra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ZIMRA Fiscalisation" string="ZIMRA Fiscalisation" name="l10n_zw_fiscalisation">
                    <h2>ZIMRA Fiscalisation</h2>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Environment</span>
                                <div class="text-muted">
                                    Select Test for development, Production when going live.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label string="Base URL" class="col-lg-4 o_light_label" for="l10n_zw_base_url"/>
                                        <field name="l10n_zw_base_url" class="col-lg-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Device Credentials</span>
                                <div class="text-muted">
                                    Details from the ZIMRA FDMS portal.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label string="Device ID" class="col-lg-4 o_light_label" for="l10n_zw_device_id"/>
                                        <field name="l10n_zw_device_id" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label string="Serial Number" class="col-lg-4 o_light_label" for="l10n_zw_serial_no"/>
                                        <field name="l10n_zw_serial_no" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label string="Device Model Name" class="col-lg-4 o_light_label" for="l10n_zw_device_model_name"/>
                                        <field name="l10n_zw_device_model_name" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label string="Device Model Version" class="col-lg-4 o_light_label" for="l10n_zw_device_model_version"/>
                                        <field name="l10n_zw_device_model_version" class="col-lg-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Certificate Paths</span>
                                <div class="text-muted">
                                    Paths to the certificate and private key files on the server.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label string="Certificate Path" class="col-lg-4 o_light_label" for="l10n_zw_cert_path"/>
                                        <field name="l10n_zw_cert_path" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label string="Private Key Path" class="col-lg-4 o_light_label" for="l10n_zw_key_path"/>
                                        <field name="l10n_zw_key_path" class="col-lg-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Fiscal Day Status</span>
                                <div class="text-muted">
                                    Current state of the fiscal register.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label string="Status" class="col-lg-4 o_light_label" for="l10n_zw_fiscal_day_status"/>
                                        <field name="l10n_zw_fiscal_day_status" class="col-lg-8" readonly="1"/>
                                    </div>
                                    <div class="row">
                                        <label string="Fiscal Day No." class="col-lg-4 o_light_label" for="l10n_zw_fiscal_day_no"/>
                                        <field name="l10n_zw_fiscal_day_no" class="col-lg-8" readonly="1"/>
                                    </div>
                                    <div class="row">
                                        <label string="Receipt Counter" class="col-lg-4 o_light_label" for="l10n_zw_receipt_counter"/>
                                        <field name="l10n_zw_receipt_counter" class="col-lg-8" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Exchange Rates (ZimRate)</span>
                                <div class="text-muted">
                                    Optionally fetch the official RBZ rate automatically from
                                    <strong>ZimRate</strong> (zimrate.statotec.com) each day.
                                    ZimRate is an <em>unofficial</em> third-party aggregator — if unavailable,
                                    update the rate manually via <strong>Accounting → Currencies</strong>.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label string="Enable ZimRate Auto-Fetch" class="col-lg-4 o_light_label" for="l10n_zw_zimrate_enabled"/>
                                        <field name="l10n_zw_zimrate_enabled" class="col-lg-8" widget="boolean_toggle"/>
                                    </div>
                                    <div class="row" attrs="{'invisible': [('l10n_zw_zimrate_enabled', '=', False)]}">
                                        <label string="Foreign Currency to Update" class="col-lg-4 o_light_label" for="l10n_zw_zimrate_currency_id"/>
                                        <field name="l10n_zw_zimrate_currency_id" class="col-lg-8"
                                               help="Typically USD if your company currency is ZWG."
                                               attrs="{'required': [('l10n_zw_zimrate_enabled', '=', True)]}"/>
                                    </div>
                                    <div class="row" attrs="{'invisible': [('l10n_zw_zimrate_enabled', '=', False)]}">
                                        <div class="col-lg-8 offset-lg-4">
                                            <p class="text-warning">
                                                <i class="fa fa-exclamation-triangle"/> Also enable the
                                                <strong>ZIMRA: Fetch ZimRate Exchange Rates</strong> cron job
                                                in Technical → Scheduled Actions for automatic daily updates.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </app>
            </xpath>
        </field>
    </record>

</odoo>